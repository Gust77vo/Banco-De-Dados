// prisma/schema.prisma

generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Papel {
  PROFESSOR
  ADMIN
}

model User {
  id        Int       @id @default(autoincrement())
  nome      String
  email     String    @unique
  foto      String?
  papel     Papel     @default(PROFESSOR)
  subjects  Subject[] @relation("ProfessorSubjects")
  questions Question[] @relation("AuthorQuestions")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model Subject {
  id          Int       @id @default(autoincrement())
  nome        String
  ativa       Boolean   @default(true)
  professorId Int       @map("professor_id")
  professor   User      @relation("ProfessorSubjects", fields: [professorId], references: [id])
  questions   Question[] @relation("SubjectQuestions")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("subjects")
}

model Question {
  id               Int      @id @default(autoincrement())
  enunciado        String
  dificuldade      Int
  respostaCorreta  String?  @map("resposta_correta")
  subjectId        Int      @map("disciplina_id")
  subject          Subject  @relation("SubjectQuestions", fields: [subjectId], references: [id])
  authorId         Int      @map("autor_id")
  author           User     @relation("AuthorQuestions", fields: [authorId], references: [id])
  ativa            Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("questions")
}
